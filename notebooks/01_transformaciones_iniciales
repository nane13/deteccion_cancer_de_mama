        "import random\n",
        "\n",
        "#obtenemos id del paciente\n",
        "def id_paciente(ruta):\n",
        "    return ruta.name.split(\"_\")[0]          # \"P100_L_DM_CC.jpg\" -> \"P100\"\n",
        "\n",
        "#obtenemos el tipo de imagen (DM=digital mammo o CM=contrasted mammo)\n",
        "def tipo_imagen(ruta):\n",
        "    return ruta.name.split(\"_\")[2]          # \"P100_L_DM_CC.jpg\" -> \"DM\"\n",
        "\n",
        "print(\"Tipos encontrados:\", Counter(tipo_imagen(r) for r in rutas))\n",
        "\n",
        "pacientes = sorted({id_paciente(r) for r in rutas})\n",
        "random.seed(42)\n",
        "random.shuffle(pacientes)\n",
        "\n",
        "#hacemos la division por pacientes (70/15/15)\n",
        "n = len(pacientes)\n",
        "train_p = set(pacientes[:int(0.70 * n)]) #228\n",
        "val_p   = set(pacientes[int(0.70 * n):int(0.85 * n)]) #49\n",
        "test_p  = set(pacientes[int(0.85 * n):]) #49\n",
        "\n",
        "#asignamos las imagenes de cada paciente a sus particiones correspondientes\n",
        "rutas_train = [r for r in rutas if id_paciente(r) in train_p]\n",
        "rutas_val   = [r for r in rutas if id_paciente(r) in val_p]\n",
        "rutas_test  = [r for r in rutas if id_paciente(r) in test_p]\n",
        "\n",
        "print(f\"Pacientes: {n}\")\n",
        "print(f\"Imágenes -> train: {len(rutas_train)} | val: {len(rutas_val)} | test: {len(rutas_test)}\")"
      ],
