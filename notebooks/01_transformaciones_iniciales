        "import torch\n",
        "from torchvision import transforms\n",
        "from tqdm import tqdm\n",
        "\n",
        "#pipeline que implementa escala de grises, resize y transformamos la imagen a tensor para torch\n",
        "transform_base = transforms.Compose([\n",
        "    transforms.Grayscale(),\n",
        "    transforms.Resize((512, 512)),\n",
        "    transforms.ToTensor(),\n",
        "])\n",
        "\n",
        "#calculamos media y desviacion estandar para las imagenes DM y CM\n",
        "def calcular_stats(lista_rutas):\n",
        "    suma, suma_cuad, n_pix = 0.0, 0.0, 0\n",
        "    for r in tqdm(lista_rutas):\n",
        "        x = transform_base(Image.open(r)) #aplicamos el pipeline\n",
        "        suma += x.sum().item() #suma de pixeles\n",
        "        suma_cuad += (x ** 2).sum().item() #suma cuadrada de pixeles (para varianza)\n",
        "        n_pix += x.numel() #conteo de pixeles\n",
        "    media = suma / n_pix\n",
        "    return media, (suma_cuad / n_pix - media ** 2) ** 0.5\n",
        "\n",
        "#calculo de estadisticas por tipo\n",
        "stats = {}\n",
        "for tipo in [\"DM\", \"CM\"]:\n",
        "    rutas_tipo = [r for r in rutas_train if tipo_imagen(r) == tipo]\n",
        "    stats[tipo] = calcular_stats(rutas_tipo)\n",
        "    print(f\"{tipo} -> media: {stats[tipo][0]:.4f}  desviación: {stats[tipo][1]:.4f}\")"
      ],
